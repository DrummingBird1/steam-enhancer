  "changelog150Selling": {
    "message": "Selling from your inventory now uses your wallet currency and shows exactly what you receive after fees."
  },
  "changelog150Alerts": {
    "message": "Wishlist-deal and price-alert notifications work again, and the historical low and price chart are back."
  },
  "changelog150Country": {
    "message": "Prices now follow the country Steam shows you; you can override it in Options."
  },
  "changelogShortcuts": {
    "message": "New keyboard shortcuts: Alt+Shift+S shows/hides the panel, Alt+Shift+W opens your wishlist. Change them at chrome://extensions/shortcuts."
  },
  "changelog150Wishlist": {
    "message": "A new wishlist dashboard beside Steam's wishlist: sort and filter by price, discount and historical low, set price alerts per game, export to CSV."
  },
  "changelog150Market": {
    "message": "Market: quick and instant sell from the inventory, a check of your listings (lowest or undercut, remove several at once) and a price-history chart."
  },
  "changelog150Options": {
    "message": "A redesigned settings page with search and presets, and recent alerts in the toolbar popup, with optional quiet hours."
  },
